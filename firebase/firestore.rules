rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if user is admin
    function isAdmin() {
      return isAuth() && 
             request.auth.token.email in 
             get(/databases/$(database)/documents/config/admin).data.adminEmails;
    }

    // Helper: email verified via Firebase link (admins bypass)
    function isVerified() {
      return isAuth() && (request.auth.token.email_verified == true || isAdmin());
    }

    // Users collection — users can read own data, admin can read/write all.
    // A user may update ONLY their own activeSessionId field (the
    // single-active-session slot, claimed/released in transactions).
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuth() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSessionId']));
      allow delete: if false;
    }

    // Sessions — users can read own, admin can read all.
    // Only verified emails (or admin) may create sessions.
    match /sessions/{sessionId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Endpoints — admin only
    match /endpoints/{endpointId} {
      allow read, write: if isAdmin();
    }

    // Cookie sets — admin only (published copy goes to config/public)
    match /cookieSets/{setId} {
      allow read, write: if isAdmin();
    }

    // Config — admin only, except the published public doc which
    // signed-in users may read (active endpoint for the dashboard)
    match /config/public {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
